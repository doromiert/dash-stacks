<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.dash-stacks" path="/org/gnome/shell/extensions/dash-stacks/">
    <key name="stacks" type="s">
      <default>'[{"name":"Downloads","path":"~/Downloads","icon":"folder-download","autoIcon":false},{"name":"Projects","path":"~/Documents","icon":"folder-documents","autoIcon":false}]'</default>
      <summary>Stacks Configuration</summary>
      <description>JSON stack entries with name, path or appFolder, icon and autoIcon.</description>
    </key>

    <key name="pinned-app-folders" type="as">
      <default>[]</default>
      <summary>Legacy app-folder pins</summary>
      <description>Read once to migrate old IDs into stacks; new app-folder pins use the existing stacks list.</description>
    </key>

    <key name="popup-width" type="i">
      <default>400</default>
      <summary>Popup Width</summary>
    </key>
    <key name="popup-height" type="i">
      <default>300</default>
      <summary>Popup Height</summary>
    </key>
    <key name="icon-size" type="i">
      <default>48</default>
      <summary>Icon Size</summary>
    </key>
    <key name="tooltip-delay" type="i">
      <default>500</default>
      <summary>Tooltip Delay</summary>
    </key>
  </schema>
</schemalist>
